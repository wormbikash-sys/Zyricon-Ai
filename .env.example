# GEMINI_API_KEY: Optional Gemini API key if used
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# --- BACKEND ENVIRONMENT VARIABLES ---
NODE_ENV="development"
PORT=3000

# PostgreSQL Database Connection String
# Leave empty in local preview to use built-in JSON file persistence
DATABASE_URL=""

# JWT Secret for Auth tokens
JWT_SECRET="nexus_ai_super_secret_jwt_key_2026_change_me_in_prod"

# AICredits API Configuration
# Get your API key from https://api.aicredits.in
AICREDITS_API_KEY=""
AICREDITS_BASE_URL="https://api.aicredits.in/v1"

# CORS Frontend Allowed Origin
FRONTEND_URL="http://localhost:3000"

# Platform Settings Defaults
DEFAULT_MODEL="deepseek/deepseek-chat"
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=100
MAX_MESSAGE_LENGTH=12000

# --- FRONTEND ENVIRONMENT VARIABLES ---
# VITE_API_URL: API endpoint URL for Vercel deployment (e.g. https://nexus-backend.onrender.com)
# Leave empty or set to /api for same-origin dev preview
VITE_API_URL=""

